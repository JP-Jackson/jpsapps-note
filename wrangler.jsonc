{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },

  // Custom domain: Cloudflare creates the DNS record and certificate itself, so
  // there is no hand-made record for note.jpsapps.com anywhere.
  "routes": [{ "pattern": "note.jpsapps.com", "custom_domain": true }],

  // Kept on deliberately, as a second door while the jpsapps.com delegation
  // propagates after the inter-account transfer. Not an Access bypass: auth.ts
  // verifies the Access JWT signature itself rather than trusting a header, so an
  // off-Access hostname returns 401 rather than letting anyone through. Turn this
  // off once note.jpsapps.com resolves and Access is live.
  "workers_dev": true,

  "assets": { "directory": "public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "note",
      "database_id": "416aa6a6-0c76-4f21-88eb-56a73c3d25bc",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "note-photos" }],

  "vars": {
    "ENVIRONMENT": "production",
    // Zero Trust team domain, e.g. "jpsapps.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // Access application Audience (AUD) tag. Not a secret.
    "ACCESS_AUD": "",
    // Only these emails may be auto-provisioned as users. Comma separated.
    "ALLOWED_EMAILS": "jpsappshq@gmail.com",
    "IMG_BASE": "https://img.jpsapps.com"
  }
}
