{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "observability": { "enabled": true },

  // note.jpsapps.com is bound after the zone is live in the jpsappshq account.
  // Uncomment once DNS is confirmed; until then `wrangler deploy` publishes to
  // the workers.dev subdomain, which is enough to prove the Worker runs.
  // "routes": [{ "pattern": "note.jpsapps.com", "custom_domain": true }],

  "assets": { "directory": "public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "note",
      "database_id": "416aa6a6-0c76-4f21-88eb-56a73c3d25bc",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "note-photos" }],

  "vars": {
    "ENVIRONMENT": "production",
    // Zero Trust team domain, e.g. "jpsapps.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "",
    // Access application Audience (AUD) tag. Not a secret.
    "ACCESS_AUD": "",
    // Only these emails may be auto-provisioned as users. Comma separated.
    "ALLOWED_EMAILS": "jpsappshq@gmail.com",
    "IMG_BASE": "https://img.jpsapps.com"
  }
}
