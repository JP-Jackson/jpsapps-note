{
  "name": "jpsapps-note",
  "version": "1.4.0",
  "description": "Note — a capture-first day log for work and home",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "version:sync": "node scripts/sync-version.mjs",
    "predeploy": "npm run version:sync",
    "db:migrate": "wrangler d1 migrations apply note --remote",
    "db:migrate:local": "wrangler d1 migrations apply note --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JP-Jackson/jpsapps-note.git"
  },
  "bugs": {
    "url": "https://github.com/JP-Jackson/jpsapps-note/issues"
  },
  "homepage": "https://github.com/JP-Jackson/jpsapps-note#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "private": true,
  "type": "module"
}
